# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore y no debe subirse nunca.

# ---------------------------------------------------------------------------
# Supabase — requeridas
# ---------------------------------------------------------------------------
# Ambas son públicas por diseño: viajan al navegador y no son un secreto. Lo que
# protege los datos es RLS, no ocultarlas.
#
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Sitio — opcional
# ---------------------------------------------------------------------------
# Dominio propio para URL canónicas, sitemap y Open Graph. Sin ella se usa el
# dominio de Vercel.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Lo que NUNCA va aquí ni en ninguna variable NEXT_PUBLIC_*
# ---------------------------------------------------------------------------
# - SUPABASE_SERVICE_ROLE_KEY  (se salta RLS por completo)
# - contraseña de la base de datos
# - access token personal de Supabase
# - tokens de Vercel o GitHub
#
# La aplicación no usa ninguno de ellos. Las migraciones se aplican con la CLI
# de Supabase desde una terminal, con credenciales que nunca entran al repo.
